// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "bun: watch",
      "dependsOn": ["bun: watch:build", "bun: watch:tsc"],
      "presentation": {
        "reveal": "never"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "type": "shell",
      "command": "bun",
      "args": ["run", "watch:build"],
      "group": "build",
      "isBackground": true,
      "label": "bun: watch:build",
      "presentation": {
        "group": "watch",
        "reveal": "never"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        {
          "owner": "bun-build-watch",
          "fileLocation": ["relative", "${workspaceFolder}"],
          "pattern": [
            {
              "regexp": "\\[error\\]\\s+(.*):(\\d+)\\s\\|\\s(.*)",
              "file": 1,
              "line": 2,
              "message": 3
            },
            {
              "regexp": "^\\s+(.*)",
              "message": 1
            },
            {
              "regexp": "TypeError:\\s+(.*)",
              "message": 1,
              "loop": true
            }
          ],
          "background": {
            "activeOnStart": true,
            "beginsPattern": "\\[info\\] Building extension",
            "endsPattern": "\\[success\\] Build completed"
          }
        }
      ]
    },
    {
      "type": "shell",
      "command": "bun",
      "args": ["run", "watch:tsc"],
      "group": "build",
      "problemMatcher": "$tsc-watch",
      "isBackground": true,
      "label": "bun: watch:tsc",
      "presentation": {
        "group": "watch",
        "reveal": "never"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "type": "shell",
      "command": "bun",
      "args": ["run", "watch:tests"],
      "label": "bun: watch:tests",
      "problemMatcher": "$tsc-watch",
      "isBackground": true,
      "presentation": {
        "reveal": "never",
        "group": "watchers"
      },
      "group": "build",
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "Generate Commands",
      "type": "shell",
      "command": "bun",
      "args": ["run", "generate:commands"],
      "problemMatcher": [],
      "group": "build",
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "Generate Types",
      "type": "shell",
      "command": "bun",
      "args": ["run", "generate:types"],
      "problemMatcher": [],
      "group": "build",
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "Generate Configuration",
      "type": "shell",
      "command": "bun",
      "args": ["run", "generate:configuration"],
      "problemMatcher": [],
      "group": "build",
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "Generate All",
      "type": "shell",
      "command": "bun",
      "args": ["run", "generate"],
      "problemMatcher": [],
      "group": "build",
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "Check Types",
      "type": "shell",
      "command": "bun",
      "args": ["run", "check-types"],
      "problemMatcher": ["$tsc"],
      "group": "test",
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "Lint",
      "type": "shell",
      "command": "bun",
      "args": ["run", "lint"],
      "problemMatcher": ["$eslint-stylish"],
      "group": "test",
      "options": {
        "cwd": "${workspaceFolder}"
      }
    }
  ]
}
